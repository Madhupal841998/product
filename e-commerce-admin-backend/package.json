{
  "name": "e-commerce-admin-backend",
  "version": "1.0.0",
  "description": "Backend for E-commerce Admin Panel",
  "main": "dist/index.js",
  "scripts": {
    "start": "npm run build && nodemon --watch 'src/**/*.ts' --ext ts --exec 'node dist/index.js'",
    "dev": "ts-node -r tsconfig-paths/register src/index.ts",
    "build": "tsc -p tsconfig.json"
  },
  "keywords": [
    "e-commerce",
    "admin",
    "panel",
    "nodejs",
    "typescript",
    "postgresql"
  ],
  "engines": {
    "node": "^10.13.0 || ^12.11.0"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@types/multer": "^1.4.12",
    "@types/uuid": "^10.0.0",
    "body-parser": "^1.19.0",
    "cors": "^2.8.5",
    "dotenv": "^8.2.0",
    "express": "^4.17.1",
    "multer": "^1.4.5-lts.2",
    "nodemon": "^3.1.9",
    "pg": "^7.18.1",
    "reflect-metadata": "^0.1.13",
    "typeorm": "^0.2.22",
    "uuid": "^3.4.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.6",
    "@types/express": "^4.17.2",
    "@types/node": "^12.12.26",
    "ts-node": "^8.6.2",
    "tsconfig-paths": "^3.9.0",
    "typescript": "^3.7.5"
  }
}